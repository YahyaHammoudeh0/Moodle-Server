# ===========================================
# Caddy Configuration - Development
# ===========================================
# Dashboard at root, services via subdomains or direct ports

# Global options for development
{
    # Use internal CA for self-signed certs
    local_certs
    auto_https disable_redirects
    # Enable debug logging
    debug
    # Enable admin API for healthchecks
    admin :2019
}

# ===========================================
# Main Dashboard - localhost:8080
# ===========================================
:80 {
    # Subdomain routing (requires /etc/hosts entries)
    @learn host learn.localhost
    handle @learn {
        reverse_proxy moodle:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto http
        }
    }

    @jupyter host jupyter.localhost
    handle @jupyter {
        reverse_proxy jupyterhub:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto http
        }
    }

    @code host code.localhost
    handle @code {
        reverse_proxy code-server:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto http
        }
    }

    @ai host ai.localhost
    handle @ai {
        reverse_proxy deepseek-proxy:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto http
        }
    }

    # Default: Service Dashboard
    handle {
        root * /srv/landing
        file_server
    }
}
