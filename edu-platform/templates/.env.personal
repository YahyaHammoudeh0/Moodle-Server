# ===========================================
# Educational Platform - Personal Mode
# ===========================================
# No passwords, instant access for self-learners
# ===========================================

# Mode
INSTALLATION_MODE=personal
DOMAIN=localhost

# Moodle - Auto-login admin
MOODLE_USERNAME=learner
MOODLE_PASSWORD=learner
MOODLE_EMAIL=learner@localhost.local
MOODLE_SITE_NAME=My Learning Platform

# Database (internal, no external access needed)
POSTGRES_PASSWORD=localdev123
POSTGRES_MOODLE_DB=moodle_db
POSTGRES_JUPYTER_DB=jupyterhub_db
POSTGRES_GRAFANA_DB=grafana

# JupyterHub - No authentication (auto-login)
JUPYTERHUB_ADMIN=learner
JUPYTERHUB_ADMIN_PASSWORD=learner
JUPYTERHUB_AUTH_MODE=dummy
JUPYTER_MEMORY_LIMIT=2G
JUPYTER_CPU_LIMIT=1.0

# Code Server - No password
CODE_SERVER_PASSWORD=
CODE_SERVER_AUTH=none

# RStudio - No authentication
RSTUDIO_PASSWORD=rstudio
RSTUDIO_DISABLE_AUTH=true

# SageMath - No token required
SAGEMATH_TOKEN=

# AI - Local Ollama (no API key needed)
OLLAMA_ENABLED=true

# Maxima
MAXIMA_POOL_SIZE=3

# Monitoring (optional)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_ANONYMOUS_ACCESS=true
