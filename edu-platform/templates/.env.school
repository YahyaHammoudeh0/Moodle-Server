# ===========================================
# Educational Platform - School/Institution Mode
# ===========================================
# Full authentication with SSO integration
# ===========================================

# Mode
INSTALLATION_MODE=school
DOMAIN=example.edu

# School Information
SCHOOL_NAME=My University
SCHOOL_SHORT_NAME=myuni
ADMIN_EMAIL=admin@example.edu

# SSL (Let's Encrypt)
SSL_ENABLED=true
LETSENCRYPT_EMAIL=admin@example.edu

# Moodle
MOODLE_USERNAME=admin
MOODLE_PASSWORD=GENERATE_SECURE_PASSWORD
MOODLE_EMAIL=admin@example.edu
MOODLE_SITE_NAME=My University Learning

# Database
POSTGRES_PASSWORD=GENERATE_SECURE_PASSWORD
POSTGRES_MOODLE_DB=moodle_db
POSTGRES_JUPYTER_DB=jupyterhub_db
POSTGRES_GRAFANA_DB=grafana

# JupyterHub - OAuth against Moodle
JUPYTERHUB_ADMIN=admin
JUPYTERHUB_ADMIN_PASSWORD=GENERATE_SECURE_PASSWORD
JUPYTERHUB_AUTH_MODE=oauth
JUPYTER_MEMORY_LIMIT=1G
JUPYTER_CPU_LIMIT=0.5

# Code Server - Password protected
CODE_SERVER_PASSWORD=GENERATE_SECURE_PASSWORD
CODE_SERVER_AUTH=password

# RStudio - Authentication enabled
RSTUDIO_PASSWORD=GENERATE_SECURE_PASSWORD
RSTUDIO_DISABLE_AUTH=false

# SageMath - Token protected
SAGEMATH_TOKEN=GENERATE_SECURE_PASSWORD

# AI - Local Ollama
OLLAMA_ENABLED=true

# OAuth Providers (configure in Moodle admin)
OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

OAUTH_MICROSOFT_ENABLED=false
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# SMTP (for email notifications)
SMTP_ENABLED=false
SMTP_HOST=smtp.example.edu
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.edu

# LDAP (optional)
LDAP_ENABLED=false
LDAP_HOST=ldap.example.edu
LDAP_PORT=389
LDAP_BASE_DN=ou=users,dc=example,dc=edu

# Maxima
MAXIMA_POOL_SIZE=5

# Monitoring
GRAFANA_USER=admin
GRAFANA_PASSWORD=GENERATE_SECURE_PASSWORD
GRAFANA_ANONYMOUS_ACCESS=false
