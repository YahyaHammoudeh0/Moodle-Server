*.log
logs/

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Python cache
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
.eggs/

# Node modules (if any)
node_modules/

# Temporary files
tmp/
temp/
*.tmp

# SSL certificates (managed by Caddy)
*.pem
*.key
*.crt
