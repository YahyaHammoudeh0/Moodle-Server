# ===========================================
# Educational Platform Configuration
# ===========================================
# Copy this file to .env and update the values
# NEVER commit .env to version control!
#
# NOTE: The start.sh/start.bat scripts auto-generate this file!
#       You only need to edit this for custom configuration.

# ===========================================
# Domain Configuration
# ===========================================
# For local development: Use "localhost"
# For production: Use your actual domain (DNS A records must point to server IP)
#
# Production subdomains:
#   - learn.DOMAIN (Moodle)
#   - jupyter.DOMAIN (JupyterHub)
#   - code.DOMAIN (Code Server)
#   - ai.DOMAIN (DeepSeek Proxy)
#
# Local development: Services available on localhost with different ports
DOMAIN=localhost

# ===========================================
# Moodle Configuration
# ===========================================
# Admin credentials
# IMPORTANT: Change these for production!
# For local dev: Auto-generated passwords are saved to CREDENTIALS.txt
MOODLE_USERNAME=admin
MOODLE_PASSWORD=ChangeMe123!SecurePassword
MOODLE_EMAIL=admin@localhost
MOODLE_SITE_NAME=Educational Platform

# ===========================================
# PostgreSQL Configuration
# ===========================================
# Master password (used for all database users)
# IMPORTANT: Use a strong, randomly generated password for production!
# For local dev: Auto-generated by start.sh/start.bat
POSTGRES_PASSWORD=SuperSecretDBPassword123!

# Database names (usually no need to change)
POSTGRES_MOODLE_DB=moodle_db
POSTGRES_JUPYTER_DB=jupyterhub_db

# ===========================================
# JupyterHub Configuration
# ===========================================
# Admin account for JupyterHub
JUPYTERHUB_ADMIN=admin
JUPYTERHUB_ADMIN_PASSWORD=JupyterAdmin456!

# Resource limits per user notebook
# Adjust based on expected concurrent users
# For 50 users on 8GB RAM: 1G memory, 0.5 CPU
JUPYTER_MEMORY_LIMIT=1G
JUPYTER_CPU_LIMIT=0.5

# ===========================================
# Code Server Configuration
# ===========================================
# Password for VS Code web access
CODE_SERVER_PASSWORD=CodeServer789!

# ===========================================
# DeepSeek API Configuration
# ===========================================
# Your DeepSeek API key from https://platform.deepseek.com
# Leave as placeholder if you don't want AI features
DEEPSEEK_API_KEY=sk-placeholder-get-your-key-from-deepseek

# Internal API key for your users (you create this)
# Share this with students/instructors for AI access
# For local dev: Auto-generated by start.sh/start.bat
DEEPSEEK_PROXY_API_KEY=your-internal-shared-key

# ===========================================
# Maxima Configuration (for STACK plugin)
# ===========================================
# Number of Maxima processes in pool
# Reduce for lower memory, increase for more concurrent STACK questions
# Recommended: 3 for 8GB RAM
MAXIMA_POOL_SIZE=3

# ===========================================
# Resource Limits
# ===========================================
# Total memory limit for all containers
# Leave ~1GB for system/buffer on 8GB RAM server
TOTAL_MEMORY_LIMIT=7G

# ===========================================
# Optional: Email Configuration (for notifications)
# ===========================================
# Uncomment and configure for email notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@example.com

# ===========================================
# Docker Compose Profiles (Optional Services)
# ===========================================
# Enable optional services using comma-separated list
# Run ./wizard.sh to configure automatically
#
# Available profiles:
# - jupyterhub, code-server, deepseek-proxy, maxima (Standard)
# - rstudio, sagemath, grafana, prometheus (Enhanced)
# - gitea, n8n, portainer (Full)
#
# Example: COMPOSE_PROFILES=jupyterhub,rstudio,grafana
COMPOSE_PROFILES=

# ===========================================
# RStudio Configuration (Optional)
# ===========================================
RSTUDIO_PASSWORD=ChangeMe123!
RSTUDIO_DISABLE_AUTH=false

# ===========================================
# SageMath Configuration (Optional)
# ===========================================
SAGEMATH_TOKEN=sage123

# ===========================================
# Gitea Configuration (Optional)
# ===========================================
GITEA_DOMAIN=localhost
POSTGRES_GITEA_DB=gitea

# ===========================================
# n8n Configuration (Optional)
# ===========================================
N8N_USER=admin
N8N_PASSWORD=ChangeMe123!
N8N_DOMAIN=localhost
POSTGRES_N8N_DB=n8n

# ===========================================
# Grafana Configuration (Optional)
# ===========================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=ChangeMe123!
GRAFANA_DOMAIN=localhost
POSTGRES_GRAFANA_DB=grafana

# ===========================================
# Optional: Backup Configuration
# ===========================================
# Hetzner Storage Box credentials (for remote backups)
# BACKUP_HOST=uXXXXXX.your-storagebox.de
# BACKUP_USER=uXXXXXX
# BACKUP_PASSWORD=your-storagebox-password
# BACKUP_PATH=/backups/edu-platform

# Or S3-compatible storage
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=your-backup-bucket
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
